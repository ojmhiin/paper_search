# ── LLM 요약 (선택) ──
# 키가 없으면 요약은 건너뛰고 수집/피드는 정상 동작합니다.
ANTHROPIC_API_KEY=
# 현재 사용 가능한 모델명은 docs.claude.com 에서 확인 후 지정
CLAUDE_MODEL=claude-sonnet-4-5

# ── OpenAlex ──
OPENALEX_MAILTO=you@example.com
HARVEST_LOOKBACK_DAYS=3

# ── DB (MVP: SQLite / 이후: postgresql+psycopg://user:pw@host/db) ──
DATABASE_URL=sqlite:///./essl_papers.db
